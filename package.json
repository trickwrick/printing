{
  "name": "shree-om-printing-press-crm",
  "private": true,
  "version": "1.0.0",
  "description": "Shree Om Printing Press CRM - Next.js full-stack",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
